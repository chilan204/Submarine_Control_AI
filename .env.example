JAVA_API_URL=http://127.0.0.1:8080/internal/voice-admin
COMMAND_API_URL=http://127.0.0.1:8080/internal/command-admin
BASE_VOICE_DIR=C:\path\to\Submarine_Control_Server\voice_samples

# When set, Java Server must use the same AI_INTERNAL_TOKEN value.
# Without a token, the AI service accepts loopback requests only.
AI_INTERNAL_TOKEN=
AI_HOST=127.0.0.1
AI_PORT=5000
MAX_AUDIO_BYTES=5242880
MAX_AUDIO_SECONDS=15

# Defaults to data/pretrained_models/vosk-model-small-vn-0.4.
VOSK_MODEL_PATH=
